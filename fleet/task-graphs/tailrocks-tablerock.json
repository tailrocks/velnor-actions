{
  "slug": "tailrocks/tablerock",
  "class": "code",
  "scheduled_gates": [
    "install",
    "build",
    "test",
    "lint",
    "format"
  ],
  "tasks": [
    {
      "name": "build",
      "cmd": "cargo build --workspace --all-targets --locked",
      "dir": ".",
      "leaf_identity": "cargo build --workspace --all-targets --locked|dir=.|env="
    },
    {
      "name": "ci",
      "depends": [
        "build",
        "test",
        "lint",
        "fmt"
      ],
      "dir": "."
    },
    {
      "name": "fmt",
      "cmd": "cargo fmt --all -- --check",
      "dir": ".",
      "leaf_identity": "cargo fmt --all -- --check|dir=.|env="
    },
    {
      "name": "lint",
      "cmd": "cargo clippy --workspace --all-targets --locked -- -D warnings",
      "dir": ".",
      "leaf_identity": "cargo clippy --workspace --all-targets --locked -- -D warnings|dir=.|env="
    },
    {
      "name": "test",
      "cmd": "cargo nextest run -p tablerock-core -p tablerock-persistence -p tablerock-tui -p tablerock-cli -p tablerock-ffi --locked",
      "dir": ".",
      "leaf_identity": "cargo nextest run -p tablerock-core -p tablerock-persistence -p tablerock-tui -p tablerock-cli -p tablerock-ffi --locked|dir=.|env="
    }
  ],
  "reachable_leaves": [
    {
      "identity": "cargo build --workspace --all-targets --locked|dir=.|env=",
      "tasks": [
        "build"
      ]
    },
    {
      "identity": "cargo clippy --workspace --all-targets --locked -- -D warnings|dir=.|env=",
      "tasks": [
        "lint"
      ]
    },
    {
      "identity": "cargo fmt --all -- --check|dir=.|env=",
      "tasks": [
        "fmt"
      ]
    },
    {
      "identity": "cargo nextest run -p tablerock-core -p tablerock-persistence -p tablerock-tui -p tablerock-cli -p tablerock-ffi --locked|dir=.|env=",
      "tasks": [
        "test"
      ]
    },
    {
      "identity": "mise install --locked|dir=.|env=",
      "tasks": [
        "gate:install"
      ]
    }
  ],
  "findings": []
}
